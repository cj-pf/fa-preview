---
import { getSiteSettings, sanityClient } from '../lib/sanity';
const settings = await getSiteSettings();

const whyFaPage = await sanityClient.fetch(`*[_type == "whyFaPage"][0]{
  "testimonials": testimonials[]{ "url": asset->url }
}`);

// Video testimonials — uploaded on the Why FA Page document in Studio. Each
// plays on demand (no autoplay) with its own audio; three show at a time on
// desktop and the rest scroll into view via the arrow.
const TESTIMONIALS: { url: string }[] = (whyFaPage?.testimonials ?? []).filter(
  (t: any) => t?.url
);

const comparison = [
  { label: 'Your brand', them: 'Replaced or co-branded', us: 'YOURS, UNCHANGED' },
  { label: 'Your clients', them: 'Theirs at exit', us: 'ALWAYS YOURS' },
  { label: 'Your equity', them: 'Sold for cash + earnout', us: 'YOU STAY THE OWNER' },
  { label: 'Exit pressure', them: 'Built to flip in 5–7 yrs', us: 'LONG-TERM HOLD' },
  { label: 'Investment freedom', them: 'Mandated models', us: 'YOU CHOOSE' },
  { label: 'Ownership', them: 'PE-backed', us: 'ADVISOR-OWNED' },
];

const outcomes = [
  { num: '01', title: 'RATIONAL COMPLIANCE THAT WORKS FOR YOU.' },
  { num: '02', title: 'FLEXIBILITY IN TECHNOLOGY.' },
  { num: '03', title: 'AI-DRIVEN TOOLS AND SUPPORT.' },
  { num: '04', title: 'OWN YOUR BOOK AND BUILD YOUR OWN EQUITY.' },
  { num: '05', title: 'A PEER NETWORK — YOU’RE NOT ALONE.' },
  { num: '06', title: 'SUCCESSION OPTIONALITY, GROWTH TAILWIND, AND MARKETING SUPPORT.' },
];

type ServiceItem = { name: string; desc: string };
type ServiceTab = {
  id: string;
  title: string;
  summary: string;
  graphic: string; // full inline SVG shown on desktop/tablet (hidden ≤900px)
  items: ServiceItem[];
};

// Original per-tab icons: 24x24, currentColor stroke (brand green via .tab-icon).
const svgWrap = (inner: string) =>
  `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${inner}</svg>`;
const graphics = {
  technology: svgWrap('<rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>'),
  operations: svgWrap('<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>'),
  investments: svgWrap('<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="3" y1="20" x2="21" y2="20"/>'),
  compliance: svgWrap('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>'),
  growthCoaching: svgWrap('<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>'),
};

const serviceTabs: ServiceTab[] = [
  {
    id: 'technology',
    title: 'Technology',
    summary: 'Institutional-grade tools — configured, supported, and ready to go on day one.',
    graphic: graphics.technology,
    items: [
      { name: 'Black Diamond Performance / Account Reporting', desc: 'Institutional-grade portfolio reporting and performance analytics that elevate your client presentations and streamline account management.' },
      { name: 'By All Account Aggregation', desc: 'Comprehensive account aggregation across all client assets, providing a complete financial picture for better planning and advisory services.' },
      { name: 'Salentica Salesforce CRM', desc: 'Purpose-built wealth management CRM that helps you systematize client relationships, track opportunities, and scale your practice efficiently.' },
      { name: 'Egnyte Cloud Client File System', desc: 'Secure, compliant cloud storage that enables seamless document management and team collaboration from anywhere.' },
      { name: 'Office 365 Suite and Email', desc: 'Enterprise-level productivity tools including email, Teams, and the complete Microsoft Office suite for professional client communications.' },
      { name: 'Preferred Pricing on Fintech Software', desc: 'Access to negotiated pricing on leading financial technology platforms, reducing your overhead and improving profit margins.' },
      { name: 'Ongoing Training and Support', desc: 'Continuous education and technical support ensuring you maximize the value of every technology platform we provide.' },
    ],
  },
  {
    id: 'operations',
    title: 'Operations',
    summary: 'We handle the back office so you can focus on clients — not paperwork.',
    graphic: graphics.operations,
    items: [
      { name: 'Quarterly Fees & Billing', desc: 'Quarterly fee calculation, billing, and collection processes that eliminate administrative burden and ensure consistent cash flow.' },
      { name: 'Initial Training for Support Staff', desc: 'Comprehensive onboarding and training for your team on FA systems and custodial platforms.' },
      { name: 'Digital Account Opening & Workflow Automation', desc: 'Streamlined Docusign account opening paired with seamless platform integrations and automated workflows that eliminate paperwork, redundant data entry, and processing delays.' },
      { name: 'Multiple Custodial Access', desc: 'Pre-established relationships with multiple custodians giving you flexibility in serving clients and negotiating better terms.' },
      { name: 'Operations Backup', desc: 'Experienced operations team ready to support your practice during staff transitions, vacations, or unexpected absences.' },
      { name: 'Transition Support', desc: 'White-glove onboarding assistance that handles the heavy lifting of moving your practice, minimizing disruption to your business.' },
      { name: 'Alternative Investments Access (RIA)', desc: 'Access to institutional alternative investment platforms and due diligence, expanding your ability to serve sophisticated clients.' },
    ],
  },
  {
    id: 'investments',
    title: 'Investments',
    summary: 'An optional turnkey investment platform — CIO-led and fully supported — to help you grow your clients’ wealth.',
    graphic: graphics.investments,
    items: [
      { name: 'Turnkey Investment Platform', desc: 'A fully-managed investment platform with models, execution, and reporting that lets advisors plug in without building an in-house investment operation.' },
      { name: 'CIO Services', desc: 'Chief Investment Officer-led strategy, market commentary, and portfolio construction that give you the intellectual capital of an institutional shop on demand.' },
      { name: 'White-Labeled Collateral & Commentary', desc: 'Client-ready market updates, investment briefs, and portfolio commentary delivered under your firm’s brand, not ours.' },
      { name: 'Active & Passive Strategies', desc: 'Access to a full spectrum of investment approaches, from low-cost index portfolios to actively managed strategies, giving you the flexibility to match each client’s mandate.' },
      { name: 'Team of CFAs & CMTs', desc: 'Dedicated investment professionals with CFA and CMT credentials driving research, security selection, and technical analysis.' },
      { name: 'Full Trading & Operational Support', desc: 'End-to-end trade execution, rebalancing, and portfolio operations that let you spend your time with clients instead of at the trade desk.' },
    ],
  },
  {
    id: 'compliance',
    title: 'Compliance',
    summary: 'Full regulatory oversight — so you can focus on what you do best and never lose sleep over an audit.',
    graphic: graphics.compliance,
    items: [
      { name: 'Compliance Oversight & CCO Support', desc: 'Comprehensive regulatory supervision with direct access to an experienced Chief Compliance Officer, powered by industry-leading compliance software that automates workflows, document management, and regulatory reporting.' },
      { name: 'SEC & FINRA Registrations, ADV Filings', desc: 'Expert handling of all regulatory registrations, ongoing filings, and Form ADV updates and amendments.' },
      { name: 'Audits & Regulatory Exams', desc: 'Professional preparation and representation during regulatory examinations, minimizing disruption and ensuring favorable outcomes.' },
      { name: 'Policy, Procedures & Code of Ethics Manuals', desc: 'Regularly updated compliance and ethics manuals tailored to wealth management practices, with clear personal trading policies that protect your clients and your reputation.' },
      { name: 'Email & Social Media Archiving & Review', desc: 'Automated capture and monitoring of all electronic communications ensuring compliance with FINRA and SEC record-keeping requirements.' },
      { name: 'E&O Insurance', desc: 'Group errors and omissions coverage providing comprehensive liability protection at preferred rates.' },
      { name: 'Annual Attestations & Account Reviews', desc: 'Systematic management of required annual certifications alongside regular review of client account activity to identify and address potential compliance issues proactively.' },
    ],
  },
  {
    id: 'growth-coaching',
    title: 'Growth Coaching',
    summary: 'A proven system designed to drive 20–30% annual growth — with the coaching, tools, and network to back it up.',
    graphic: graphics.growthCoaching,
    items: [
      { name: '5 Pillar Growth Plan', desc: 'Proven framework that systematically drives 20–30% annual growth through strategic client acquisition and relationship development.' },
      { name: 'Book of Business Segmentation and Optimization', desc: 'Data-driven analysis to identify your best clients, optimize service models, and increase profitability per relationship.' },
      { name: 'Client Advocacy & COI Referral Strategy', desc: 'Structured programs that transform satisfied clients into active advocates alongside a systematic approach to building and leveraging Centers of Influence — creating predictable, referral-based growth.' },
      { name: 'Next-Gen Outreach & Workshop System', desc: 'Modern marketing and engagement approaches to attract next-generation high-net-worth clients, paired with turnkey educational events and seminars that position you as the local expert and generate qualified prospects.' },
      { name: '1v1 Planning & Coaching Sessions', desc: 'Regular personalized coaching with experienced advisors who have successfully scaled their practices.' },
      { name: 'Access to the FA Advisory Network', desc: 'Collaborative community of growth-focused advisors sharing best practices, strategies, and support.' },
      { name: 'Talent Strategy', desc: 'Recruiting and staffing processes to help you acquire and maintain the best team.' },
    ],
  },
];
---

<section class="surface-elev">
  <div class="container">
    <div class="section-head anim-hidden">
      <p class="eyebrow">The difference</p>
      <h2>AN ALLIANCE — NOT AN AGGREGATOR.</h2>
    </div>
    <table class="ctable anim-hidden">
      <thead>
        <tr>
          <th></th>
          <th>Typical aggregator</th>
          <th class="col-us-head">Fiduciary Alliance</th>
        </tr>
      </thead>
      <tbody>
        {comparison.map(row => (
          <tr>
            <td class="row-label">{row.label}</td>
            <td class="col-them">{row.them}</td>
            <td class="col-us">{row.us}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<section>
  <div class="container">
    <div class="section-head anim-hidden">
      <p class="eyebrow">The FA difference</p>
      <h2>WHAT CHANGES WHEN YOU JOIN.</h2>
    </div>
    <div class="outcomes">
      {outcomes.map((o, i) => (
        <div class="outcome anim-hidden" style={`--anim-delay: ${i * 80}ms`}>
          <div class="num">{o.num}</div>
          <h3>{o.title}</h3>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="services-section">
  <div class="container">
    <div class="section-head anim-hidden">
      <p class="eyebrow">The platform</p>
      <h2>WHAT WE PROVIDE.</h2>
    </div>
    <div class="services-tabs anim-hidden">
      <div class="tabs-nav" role="tablist" aria-label="Service categories">
        {serviceTabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`tab-${tab.id}`}
            aria-controls={`panel-${tab.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >{tab.title}</button>
        ))}
      </div>
      <div class="tab-panels">
      {serviceTabs.map((tab, i) => (
        <div
          class="tab-panel"
          role="tabpanel"
          id={`panel-${tab.id}`}
          aria-labelledby={`tab-${tab.id}`}
          hidden={i !== 0}
        >
          <div class="tab-panel-grid">
            <div class="tab-panel-left">
              <div class="tab-icon" aria-hidden="true" set:html={tab.graphic}></div>
              <h3 class="tab-headline">{tab.title}</h3>
              <p class="tab-summary">{tab.summary}</p>
            </div>
            <ul class="tab-items">
              {tab.items.map(item => (
                <li class="tab-item">
                  <details class="tab-item-details">
                    <summary>
                      <span class="tab-item-icon" aria-hidden="true">
                        <svg viewBox="0 0 20 20" width="14" height="14">
                          <path d="M5 10l3.5 3.5L15 7" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                      <span class="tab-item-name">{item.name}</span>
                      <span class="tab-item-chevron" aria-hidden="true">
                        <svg viewBox="0 0 20 20" width="16" height="16">
                          <path d="M5 8l5 5 5-5" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                    </summary>
                    <p class="tab-item-desc">{item.desc}</p>
                  </details>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
      </div>
    </div>
  </div>
</section>

<section id="how-a-partnership-works">
  <div class="container">
    <div class="section-head anim-hidden">
      <p class="eyebrow">How a partnership works</p>
      <h2>FROM FIRST CONVERSATION TO LAUNCH.</h2>
      <p style="margin-top:1.25rem;max-width:60ch;">A step-by-step walkthrough of the partnership process — onboarding, transition support, and what your first 90 days look like inside the alliance. Detailed timeline coming soon.</p>
    </div>
  </div>
</section>

{TESTIMONIALS.length > 0 && (
  <section class="vt-section">
    <div class="container">
      <div class="section-head anim-hidden">
        <p class="eyebrow">In their words</p>
        <h2>HEAR IT FROM ADVISORS.</h2>
      </div>
      <div class="vt-carousel anim-hidden">
        <div class="vt-track" role="list">
          {TESTIMONIALS.map((t, i) => (
            <article class="vt-card" role="listitem">
              <div class="vt-media">
                <video
                  class="vt-video"
                  src={`${t.url}#t=0.1`}
                  preload="metadata"
                  playsinline
                  aria-label={`Advisor testimonial ${i + 1}`}
                ></video>
                <button type="button" class="vt-play" aria-label={`Play testimonial ${i + 1}`}>
                  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
                    <path d="M8 5v14l11-7z" fill="currentColor" />
                  </svg>
                </button>
              </div>
            </article>
          ))}
        </div>
        <button type="button" class="vt-arrow vt-arrow-prev" aria-label="Previous testimonials" hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="vt-arrow vt-arrow-next" aria-label="See more testimonials">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>
  </section>
)}

<section class="cta-strip cta-strip-plain">
  <div class="container">
    <div class="cta-row anim-hidden">
      <h2>READY TO SEE IF YOU&rsquo;RE A FIT?</h2>
      <div class="actions">
        <a class="btn btn-primary" href={settings.calendlyUrl} target="_blank" rel="noopener">See If You&rsquo;re a Fit <span class="arrow">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Closing CTA on the Why FA pages has no banner photo — the video
     testimonials above it carry the visual weight. Drop the global photo layer
     and let the brand gradient sit on a solid deep base. */
  .cta-strip-plain { background: var(--bg-deep); }
  .cta-strip-plain::before { display: none; }

  /* --- Video testimonials carousel --- */
  .vt-carousel {
    position: relative;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .vt-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * 1.25rem) / 3);
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
  .vt-track::-webkit-scrollbar { display: none; }
  .vt-card { scroll-snap-align: start; }
  .vt-media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--bg-deep);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
  }
  .vt-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: var(--bg-deep);
  }
  .vt-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 4.25rem;
    height: 4.25rem;
    display: grid;
    place-items: center;
    padding: 0 0 0 0.2rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: rgba(10, 26, 36, 0.55);
    backdrop-filter: blur(6px);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .vt-play:hover {
    background: var(--brand-green);
    border-color: var(--brand-green-bright);
    transform: scale(1.06);
  }
  .vt-media.is-playing .vt-play { display: none; }

  .vt-arrow {
    position: absolute;
    top: calc(50% - 1.4rem);
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink-soft);
    cursor: pointer;
    box-shadow: var(--shadow);
    transition: opacity 0.2s ease, background 0.2s ease, color 0.2s ease;
    z-index: 2;
  }
  .vt-arrow:hover { background: var(--surface-2); color: var(--ink); }
  .vt-arrow-prev { left: -0.5rem; }
  .vt-arrow-next { right: -0.5rem; }
  .vt-arrow[hidden] { display: none; }
  .vt-arrow[disabled] { opacity: 0; pointer-events: none; }

  @media (max-width: 900px) {
    .vt-track { grid-auto-columns: calc((100% - 1rem) / 2); gap: 1rem; }
  }
  @media (max-width: 600px) {
    .vt-track { grid-auto-columns: 78%; }
    .vt-arrow-prev { left: 0.25rem; }
    .vt-arrow-next { right: 0.25rem; }
  }
</style>

<script>
  function setupServiceTabs() {
    document.querySelectorAll<HTMLElement>('.services-tabs').forEach(group => {
      if (group.dataset.ready === '1') return;
      group.dataset.ready = '1';
      const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const panels = Array.from(group.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
      const activate = (idx: number) => {
        tabs.forEach((t, i) => {
          const on = i === idx;
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.setAttribute('tabindex', on ? '0' : '-1');
          panels[i].hidden = !on;
        });
      };
      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => activate(idx));
        tab.addEventListener('keydown', (e) => {
          const len = tabs.length;
          if (e.key === 'ArrowRight') { e.preventDefault(); const n = (idx + 1) % len; activate(n); tabs[n].focus(); }
          else if (e.key === 'ArrowLeft') { e.preventDefault(); const n = (idx - 1 + len) % len; activate(n); tabs[n].focus(); }
          else if (e.key === 'Home') { e.preventDefault(); activate(0); tabs[0].focus(); }
          else if (e.key === 'End') { e.preventDefault(); activate(len - 1); tabs[len - 1].focus(); }
        });
      });
    });
  }
  function setupWhyFaAnimations() {
    const els = document.querySelectorAll<HTMLElement>('.anim-hidden');
    if (!els.length) return;
    if (!('IntersectionObserver' in window)) {
      els.forEach(el => el.classList.remove('anim-hidden'));
      return;
    }
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        observer.unobserve(el);
        el.classList.add('anim-visible');
        const cleanup = () => el.classList.remove('anim-hidden', 'anim-visible');
        el.addEventListener('transitionend', cleanup, { once: true });
        window.setTimeout(cleanup, 1800);
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

    // Reveal anything already in view immediately (no entry animation) to avoid
    // a flash; observe the rest so they animate in as they scroll into view.
    const vh = window.innerHeight;
    els.forEach(el => {
      const rect = el.getBoundingClientRect();
      const inView = rect.top < vh && rect.bottom > 0;
      if (inView) el.classList.remove('anim-hidden');
      else observer.observe(el);
    });
  }

  function setupTestimonials() {
    document.querySelectorAll<HTMLElement>('.vt-carousel').forEach(carousel => {
      if (carousel.dataset.ready === '1') return;
      carousel.dataset.ready = '1';

      const track = carousel.querySelector<HTMLElement>('.vt-track');
      const prev = carousel.querySelector<HTMLButtonElement>('.vt-arrow-prev');
      const next = carousel.querySelector<HTMLButtonElement>('.vt-arrow-next');
      if (!track) return;

      // Play on demand; pause any other testimonial that's playing so only one
      // has audio at a time. Show native controls once a video has started.
      const videos = Array.from(track.querySelectorAll<HTMLVideoElement>('.vt-video'));
      carousel.querySelectorAll<HTMLButtonElement>('.vt-play').forEach(btn => {
        btn.addEventListener('click', () => {
          const media = btn.closest('.vt-media');
          const video = media?.querySelector<HTMLVideoElement>('.vt-video');
          if (!video) return;
          videos.forEach(v => { if (v !== video) { v.pause(); } });
          media?.classList.add('is-playing');
          video.controls = true;
          void video.play();
        });
      });

      // Arrows page the track by (almost) its full visible width. They only
      // matter when the content overflows — otherwise both stay hidden.
      const updateArrows = () => {
        const overflow = track.scrollWidth - track.clientWidth > 4;
        if (!overflow) {
          if (prev) prev.hidden = true;
          if (next) next.hidden = true;
          return;
        }
        const atStart = track.scrollLeft <= 4;
        const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
        if (prev) { prev.hidden = false; prev.disabled = atStart; }
        if (next) { next.hidden = false; next.disabled = atEnd; }
      };
      const page = (dir: number) => {
        track.scrollBy({ left: dir * track.clientWidth * 0.92, behavior: 'smooth' });
      };
      prev?.addEventListener('click', () => page(-1));
      next?.addEventListener('click', () => page(1));
      track.addEventListener('scroll', updateArrows, { passive: true });
      window.addEventListener('resize', updateArrows);
      updateArrows();
    });
  }

  setupServiceTabs();
  setupWhyFaAnimations();
  setupTestimonials();
  document.addEventListener('astro:page-load', () => {
    setupServiceTabs();
    setupWhyFaAnimations();
    setupTestimonials();
  });
</script>
