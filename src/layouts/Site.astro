---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
}
const {
  title,
  description = 'Fiduciary Alliance — an advisor-owned network of independent RIAs.',
  bodyClass,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Brand kit typefaces (Trade Gothic Next / Museo Sans) via Adobe Fonts.
         This is the ONLY web font provider — do not add Google Fonts back. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/gut5szx.css" />
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <Header transition:persist />
    <slot />
    <Footer />
    <script>
      // Connect to Sanity's Presentation (preview) pane so editors can navigate
      // the site from the Studio. Only runs inside an iframe (the preview pane),
      // and the (heavy) library is dynamically imported so normal visitors never
      // download it.
      if (window.self !== window.top) {
        import('@sanity/visual-editing').then(({enableVisualEditing}) => enableVisualEditing());
      }
    </script>
  </body>
</html>
